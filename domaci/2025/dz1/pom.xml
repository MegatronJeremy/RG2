<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.etf.rg2</groupId>
    <artifactId>RG2</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>9</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jogamp.gluegen</groupId>
            <artifactId>gluegen-rt-main</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.jogamp.jogl</groupId>
            <artifactId>jogl-all-main</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.9.15</version>
        </dependency>

        <dependency>
            <groupId>org.l33tlabs.twl</groupId>
            <artifactId>pngdecoder</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>9</release>
                </configuration>
            </plugin>

            <!-- Run from the command line: mvn compile exec:exec
                 Forks a fresh JVM (via exec:exec, not exec:java) so JOGL's native
                 methods bind under the system classloader. exec:java runs the app
                 inside Maven's JVM under a custom URLClassLoader, where gluegen_rt's
                 JNI method LoadLibraryExW fails to bind, so no GL profiles load and
                 GLProfile.get(GL4) throws "GL4 not available, but: []".
                 JOGL 2.6.0 is a modular jar (module jogl.all); its NEWT/util packages
                 are not exported to the unnamed module, so add-exports opens them. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.newt.event=ALL-UNNAMED</argument>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.newt=ALL-UNNAMED</argument>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.newt.opengl=ALL-UNNAMED</argument>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.opengl.util=ALL-UNNAMED</argument>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.opengl.util.awt=ALL-UNNAMED</argument>
                        <argument>--add-exports</argument>
                        <argument>jogl.all/com.jogamp.opengl.util.texture=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>opengl4.dz1.Main</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>